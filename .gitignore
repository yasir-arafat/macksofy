# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# index-tracker run artifacts (keep the script + watch list, not the snapshots)
/scripts/index-snapshots/

# python bytecode from the scripts/ helpers
__pycache__/

# service-account / OAuth credentials. scripts/gsc_client.py deliberately reads
# its key from OUTSIDE this repo, but this repo pushes to GitHub and auto-deploys
# to Vercel, so a stray key dropped in here must never be committable. None of
# the rules above match these filenames (*.pem and .env* both miss them).
service-account*.json
*-service-account.json
client_secret_*.json
*credentials.json
token.json
